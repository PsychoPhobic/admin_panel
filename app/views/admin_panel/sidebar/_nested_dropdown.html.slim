- dropdown_id = "dropdown-#{id}"
li
  button type="button" class="flex items-center w-full p-2 text-base text-gray-900 transition duration-75 rounded-lg pl-11 group hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700" aria-controls=dropdown_id data-collapse-toggle=dropdown_id
    span class="flex-1 text-left whitespace-nowrap" sidebar-toggle-item="" = label
    = render "admin_panel/sidebar/chevron"
  ul id=dropdown_id class="py-2 space-y-2 hidden"
    == content
